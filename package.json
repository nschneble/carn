{
  "name": "@nschneble/carn",
  "version": "0.0.0",
  "description": "A self-hosted git forge. Repos, issues, and PRs.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "migrate": "set -a && . ./.env && set +a && prisma migrate deploy",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "node --test \"dist/test/**/*.js\""
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "fastify": "^5.12.1"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "prettier": "^3.9.6",
    "prisma": "^7.9.1",
    "squawk-cli": "^2.62.0",
    "typescript": "^7.0.2"
  }
}
