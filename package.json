{
  "name": "@nschneble/carn",
  "version": "0.0.0",
  "description": "A self-hosted git forge. Repos, issues, and PRs.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "biome:migrate": "biome migrate --write",
    "build": "prisma generate && tsc",
    "db:reset": "set -a && . ./.env && set +a && prisma migrate reset --force",
    "format": "biome check --write .",
    "format:check": "biome check .",
    "key:add": "node --env-file-if-exists=.env dist/scripts/add-key.js",
    "migrate": "set -a && . ./.env && set +a && prisma migrate deploy",
    "prepare": "git config core.hooksPath .githooks || true",
    "pretest": "npm run build",
    "test": "node --test \"dist/test/**/*.js\""
  },
  "allowScripts": {
    "@prisma/engines@7.9.1": true,
    "prisma@7.9.1": true
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "fastify": "^5.12.1",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.10",
    "@types/node": "^26.3.0",
    "@types/ssh2": "^1.15.5",
    "prisma": "^7.9.1",
    "squawk-cli": "^2.62.0",
    "typescript": "^7.0.2"
  }
}
