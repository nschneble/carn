// first three functions are deliberately incorrect; the fixture extension
// keeps it all uncompiled

import { html, raw } from "../../src/html/index.js";
import { renderMarkdown } from "../../src/markdown/render.js";

export function plantedDoubleQuoted(readme: string) {
  return html`<article data-readme="${renderMarkdown(readme)}"></article>`;
}

export function plantedSingleQuoted(readme: string) {
  return html`<article data-readme='${raw(readme)}'></article>`;
}

export function plantedBareValue(readme: string) {
  return html`<article title=${renderMarkdown(readme)}></article>`;
}

export function safeAlongside(readme: string, name: string) {
  return html`<article><h1>${name}</h1>${renderMarkdown(readme)}</article>`;
}
