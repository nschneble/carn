# Copy to `.env`. Node loads it with `node --env-file=.env`.

# required; database compose.yaml provisions on 127.0.0.1:5433
DATABASE_URL=postgresql://carn:carn@127.0.0.1:5433/carn

# required; must match the password in DATABASE_URL
POSTGRES_PASSWORD=carn

# all values below are optional

# ISO timestamp for relative-time strings in pinned visual baselines
# CARN_FROZEN_NOW=2026-02-01T12:00:00.000Z

CARN_ORIGIN=https://carn.fancyenchiladas.net
CARN_REPO_ROOT=./local/repos

# footer source link; AGPL wants modified installs to name own source
CARN_SOURCE_URL=https://github.com/nschneble/carn

CARN_SSH_HOST=127.0.0.1
CARN_SSH_HOST_KEY=./local/ssh_host_ed25519_key
CARN_SSH_PORT=2222

HOST=127.0.0.1
NODE_ENV=development
PORT=3000
