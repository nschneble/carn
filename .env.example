# Copy to .env. Node loads it with `node --env-file=.env`.

# Required. The database compose.yaml provisions on 127.0.0.1:5433
DATABASE_URL=postgresql://carn:carn@127.0.0.1:5433/carn

# Read by compose, not by the app. Must match the password in DATABASE_URL.
POSTGRES_PASSWORD=carn

# Optional. The values shown are the defaults applied when unset.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
