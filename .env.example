# Copy to .env. Node loads it with `node --env-file=.env`.

# Required. Shape only; compose.yaml serves db `carn` on 127.0.0.1:5432
DATABASE_URL=postgresql://user:password@host:5432/database

# Optional. The values shown are the defaults applied when unset.
PORT=3000
HOST=127.0.0.1
NODE_ENV=development
