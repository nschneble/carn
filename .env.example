# Copy this file to `.env`. Node loads it with `node --env-file=.env`.

# Required. The database compose.yaml provisions on 127.0.0.1:5433 and
# reads in POSTGRES_PASSWORD. Must match the password in DATABASE_URL.

DATABASE_URL=postgresql://carn:carn@127.0.0.1:5433/carn
POSTGRES_PASSWORD=carn

# Optional. Default values are filled in below.

HOST=127.0.0.1
NODE_ENV=development
PORT=3000
